Algoritmo intervalos
	
	Definir num Como Real
	Escribir "Ingrese un numero:"
	Leer num
	Si num >= 20 Y num <= 50 Entonces
        Escribir "El numero esta en el intervalo del 20 al 50"
    SiNo 
		Si num >= 51 Y num <= 69 Entonces
			Escribir "El numero esta en el intervalo del 51 al 69"
		SiNo 
			Si num >= 70 Y num <= 120 Entonces
				Escribir "El numero esta en el intervalo del 70 al 120"
			SiNo 
				Si num >= 121 Y num <= 149 Entonces
					Escribir "El numero esta en el intervalo del 121 al 149"
				SiNo 
					Si num >= 150 Y num <= 300 Entonces
						Escribir "El numero esta en el intervalo del 150 al 300"
					SiNo
						Escribir "El numero no se encuentra en ningun intervalo"
					FinSi
				FinSi
			FinSi
		FinSi
    FinSi
FinAlgoritmo