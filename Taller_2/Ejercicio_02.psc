Algoritmo v_mayor_menor
	
	Definir num1, num2 Como Real
	Escribir "Ingrese dos valores:"
	Leer num1, num2 
	
	Si num1 >= num2 Entonces
		Escribir "El primer valor es mayor: ", num1
		Escribir "El segundo valor es menor: ", num2 
	SiNo
		Escribir "El segundo valor es mayor: ", num2
		Escribir "El primer valor es menor: ", num1
	FinSi
FinAlgoritmo