Algoritmo conversion_de_divisas
	Definir pesoscolombianos, dolares, euros Como Real
	Escribir "Digite en numeros un valor en pesos colombianos"
	Leer pesoscolombianos
	
	dolares<- (pesoscolombianos/3200)
	euros <- (pesoscolombianos/3700)
	
	Escribir "El valor en pesos colombianos es: ", pesoscolombianos
	Escribir "El valor en dolares es: ", dolares
	Escribir "El valor en euros es: ", euros 	
FinAlgoritmo